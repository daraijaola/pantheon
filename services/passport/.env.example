# HYPE Passport attestor: copy to .env (never committed) and adjust.
# Secrets are FILE PATHS, never values. Key files must be mode 0600.

CHAIN_ID=99801
ELYSIUM_RPC=https://testnet-rpc.elysium.kinetiq.xyz
HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm
HL_INFO_URL=https://api.hyperliquid.xyz/info

# HypePassportRegistry on Elysium; empty until it is deployed (P9).
REGISTRY_ADDRESS=

ATTESTOR_KEY_FILE=/var/lib/passport/keys/attestor.key
RELAYER_KEY_FILE=/var/lib/passport/keys/relayer.key
PEPPER_FILE=/var/lib/passport/keys/pepper
DB_PATH=/var/lib/passport/passport.db

HL_WEIGHT_PER_MIN=800
EVM_REQ_PER_MIN=60
PORT=8787
