{
  "name": "@pantheon/passport",
  "version": "0.1.0",
  "private": true,
  "description": "HYPE Passport attestor service (docs/PASSPORT_SPEC.md)",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:contracts": "cd contracts-check && forge test",
    "fixture:attestation": "node scripts/make-attestation-fixture.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "viem": "^2.57.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@metamask/eth-sig-util": "^9.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3": false
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
