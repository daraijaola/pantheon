# DELPHI: copy to .env (never committed) if you need to change anything. Every value has a
# working default for Elysium testnet. DELPHI is read-only: it uses no keys and no secrets.

ELYSIUM_RPC=https://testnet-rpc.elysium.kinetiq.xyz
EXPLORER_API=https://elysium.kinetiq.xyz/api/v2
EXPLORER_WEB=https://elysium.kinetiq.xyz/testnet-explorer

# Ascend redeploys often: point this at the current launchpad; everything else is read from it.
LAUNCHPAD=0xE2f6254508DEB93Da081837F545e0bAF7b00d8E9
# First block to scan (just before the first launch on this launchpad).
FROM_BLOCK=3574000

DB_PATH=data/delphi.db
OUT_DIR=out
