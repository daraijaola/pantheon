{
  "name": "@pantheon/delphi",
  "version": "0.1.0",
  "private": true,
  "description": "DELPHI: flags Ascend coins with bundled launches, wash trading or hidden concentration, with on-chain evidence",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "allowScripts": {
    "better-sqlite3": false
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "better-sqlite3": "^13.0.3",
    "viem": "^2.57.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
